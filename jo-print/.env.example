# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage bucket name (create in Supabase Storage)
STORAGE_BUCKET=print-files
NEXT_PUBLIC_STORAGE_BUCKET=print-files

# Twilio — for WhatsApp/SMS notifications (optional)
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp contact number for teacher bookings (without + prefix)
NEXT_PUBLIC_WHATSAPP_NUMBER=96279123456
