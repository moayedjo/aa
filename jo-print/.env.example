# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server-side only, never expose to client

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage bucket name (create in Supabase Storage)
STORAGE_BUCKET=print-files
NEXT_PUBLIC_STORAGE_BUCKET=print-files

# Twilio — for WhatsApp/SMS notifications (optional)
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp contact number for teacher bookings (without + prefix)
NEXT_PUBLIC_WHATSAPP_NUMBER=962781141113

# Public contact info
NEXT_PUBLIC_CONTACT_PHONE=+962781141113
NEXT_PUBLIC_CONTACT_EMAIL=info@joprint.jo

# JO Study — AI study assistant (server-side only, never expose to client)
# Get OPENAI_API_KEY from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: pre-created vector store id for OpenAI File Search retrieval
OPENAI_VECTOR_STORE_ID=

# Sentry — error monitoring (optional)
# Get from https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
